# --- SQL Server configuration (Windows Authentication) ---
SQLSERVER_HOST=host.docker.internal
SQLSERVER_INSTANCE=SQLEXPRESS
AUTH_DB_NAME=Feane.AuthServiceDb
MVC_DB_NAME=FeaneMvcDb

# --- Shared JWT configuration ---
AUTH_JWT_SECRET=A38665B7-1B5A-4F62-A392-E9274BBA4A96
AUTH_JWT_ISSUER=Feane.AuthService
AUTH_JWT_AUDIENCE=Feane.Clients
GATEWAY_JWT_ISSUER=FeaneMVC
GATEWAY_JWT_AUDIENCE=FeaneMVCUsers
MVC_JWT_ISSUER=FeaneMVC
MVC_JWT_AUDIENCE=FeaneMVCUsers

# --- Service ports exposed to the host ---
AUTH_SERVICE_PORT=5010
GATEWAY_PORT=5000
FEANE_MVC_PORT=5001
FEANE_FRONTEND_PORT=5003

# ASP.NET Core environment (Development, Staging, Production)
ASPNETCORE_ENVIRONMENT=Development