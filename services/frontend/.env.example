# URL до gateway-сервиса. Используется для проксирования запросов авторизации
VITE_GATEWAY_BASE_URL=http://localhost:5200

# Префикс маршрутов авторизации за gateway. Должен совпадать с конфигурацией YARP
VITE_AUTH_PREFIX=/api/auth

# Необязательные переопределения портов разработки
# VITE_DEV_SERVER_PORT=5173
# VITE_PREVIEW_PORT=4173
