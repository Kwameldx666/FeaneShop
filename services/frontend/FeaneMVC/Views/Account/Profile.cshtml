@model FeaneMVC.Contracts.Reservations.ReservationHistoryPageModel
@using System
@using System.Linq

@{
    Layout = "_LayoutProfile";
    var hasReservations = Model?.Reservations?.Any() == true;
    var now = DateTime.UtcNow;
}

@section Styles {
    <link rel="stylesheet" href="~/css/account-profile.css" />
}

<div class="page_layout page_layout-clear">
    <main>
        <div class="layout">
            <div class="layout__content">
                <div class="checkout-v2-wrapper co-section--content_wrapper">
                    <div class="co-sidebar--menu">
                        <input class="co-menu-switcher" id="co-menu-toggle" type="checkbox" />
                        <label class="co-menu-toggle" data-title="Личный кабинет" for="co-menu-toggle"></label>
                        <div class="co-menu co-menu--personal co-checkout-block--padded">
                            <div class="co-menu-item co-menu-item--personal">
                                <a class="co-menu-link co-menu-link--personal co-link co-menu-link--active" asp-action="Profile">
                                    История резерваций
                                </a>
                            </div>
                            <div class="co-menu-item co-menu-item--personal">
                                <a class="co-menu-link co-menu-link--personal co-link" asp-action="Addresses">
                                    Адрес доставки
                                </a>
                            </div>
                            <div class="co-menu-item co-menu-item--personal">
                                <a class="co-menu-link co-menu-link--personal co-link" asp-action="Contacts">
                                    Контактные данные
                                </a>
                            </div>
                            <div class="co-menu-item co-menu-item--personal">
                                <a class="co-menu-link co-menu-link--personal co-link" asp-action="Logout">
                                    Выход
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="co-section--content">
                        <div class="co-section--checkout_header co-checkout-block--padded">
                            <h1 class="co-checkout-title co-title co-title--h1">
                                История резерваций
                            </h1>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model?.StatusMessage))
                        {
                            <div class="alert alert-success" role="alert">@Model.StatusMessage</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model?.ErrorMessage))
                        {
                            <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
                        }

                        @if (hasReservations)
                        {
                            <div class="table-responsive">
                                <table class="table table-striped align-middle">
                                    <thead>
                                        <tr>
                                            <th>Дата резервации</th>
                                            <th>Повод</th>
                                            <th>Гостей</th>
                                            <th>Статус</th>
                                            <th>Сумма</th>
                                            <th class="text-center">Действия</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var reservation in Model.Reservations)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="fw-semibold">@reservation.ReservationDate.ToLocalTime().ToString("dd MMMM yyyy, HH:mm")</div>
                                                    @if (!string.IsNullOrWhiteSpace(reservation.SpecialRequests))
                                                    {
                                                        <div class="text-muted small">@reservation.SpecialRequests</div>
                                                    }
                                                </td>
                                                <td>@(reservation.Occasion ?? "—")</td>
                                                <td>@reservation.NumberOfPeople</td>
                                                <td>
                                                    <span class="badge bg-light text-dark">@reservation.Status</span>
                                                </td>
                                                <td>@reservation.Amount.ToString("F2") BYN</td>
                                                <td class="text-center">
                                                    <form asp-action="CancelReservation" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@reservation.Id" />
                                                        <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Отменить резервацию?');" @(reservation.ReservationDate <= now ? "disabled" : string.Empty)>
                                                            Отменить
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info" role="alert">
                                Вы не сделали ещё ни одной резервации.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
