@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password</title>
    <link rel="stylesheet" href="~/css/account-index.css" />
</head>
<body>
    <div class="container">
        <button id="forgot-password-btn" class="btn">Забыли пароль?</button>

        <div id="forgot-password-form" class="form-container hidden">
            <h2>Восстановление пароля</h2>
            <p>Пожалуйста, введите свою электронную почту, чтобы получить новый пароль.</p>
            <input type="email" id="email" placeholder="Введите вашу почту" required>
            <button id="send-password-btn" class="btn">Отправить новый пароль</button>
        </div>
    </div>


</body>
</html>

