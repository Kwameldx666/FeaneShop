@using System.Linq
@model IEnumerable<Feane.Contracts.Dishes.DishResponse>

@{ 
    var dishes = Model ?? Enumerable.Empty<Feane.Contracts.Dishes.DishResponse>();
}

<link rel="stylesheet" href="~/css/food-section.css" />

<section class="food_section layout_padding-bottom">
    <div class="container">
        <div class="heading_container heading_center">
            <h2>Our Menu</h2>
        </div>

        <div id="food-feedback" class="alert d-none" role="alert"></div>

        <ul class="filters_menu">
            <li class="active" data-filter="*">All</li>
            <li data-filter=".burger">Burger</li>
            <li data-filter=".pizza">Pizza</li>
            <li data-filter=".pasta">Pasta</li>
            <li data-filter=".fries">Fries</li>
        </ul>

        <div class="filters-content">
            @if (!dishes.Any())
            {
                if (ViewBag.Message != null)
                {
                    <p>@ViewBag.Message</p>
                }
            }
            else
            {
                <div class="row grid">
                    @foreach (var dish in dishes)
                    {
                        <div class="col-sm-6 col-lg-4 all @dish.Category.ToLower()" data-name="@dish.Name" data-price="@dish.Price">
                            <div class="box">
                                <div>
                                    <div class="img-box">
                                        <img src="@(!string.IsNullOrWhiteSpace(dish.ImageUrl) ? Url.Content(dish.ImageUrl) : "~/images/default.png")" alt="@dish.Name">
                                    </div>
                                    <div class="detail-box">
                                        <h5 class="name">@dish.Name</h5>
                                        <p>@dish.Description</p>
                                        <div class="options">
                                            <h6 class="price">$@(dish.Price > 0 ? dish.Price.ToString("0.00") : "N/A")</h6>
                                            <span class="cart-icon disabled" title="Ordering via gateway будет добавлено позже">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-shopping-cart">
                                                    <circle cx="9" cy="21" r="1"></circle>
                                                    <circle cx="20" cy="21" r="1"></circle>
                                                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                                </svg>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

<script src="~/js/food-section.js"></script>
