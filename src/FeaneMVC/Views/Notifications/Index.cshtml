@model FeaneMVC.Contracts.Notifications.NotificationsPageModel
@{
    Layout = null;
}
<h1>Notifications</h1>

<a asp-action="Filters">Manage Filters</a>

<section class="mt-4">
    <h2>Send email notification</h2>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="alert">@Model.SuccessMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    <form asp-action="SendEmail" method="post" class="card card-body mt-3">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label asp-for="Email.RecipientEmail" class="form-label"></label>
            <input asp-for="Email.RecipientEmail" class="form-control" />
            <span asp-validation-for="Email.RecipientEmail" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Email.Subject" class="form-label"></label>
            <input asp-for="Email.Subject" class="form-control" />
            <span asp-validation-for="Email.Subject" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Email.Message" class="form-label"></label>
            <textarea asp-for="Email.Message" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Email.Message" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Send message</button>
    </form>
</section>

@foreach (var group in Model.Groups)
{
    <h2 class="mt-5">@group.Key</h2>
    <ul>
        @foreach (var notification in group.Value)
        {
            <li>@notification.Content (ID: @notification.Id)</li>
        }
    </ul>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

