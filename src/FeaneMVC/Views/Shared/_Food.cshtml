<link rel="stylesheet" href="/css/food-section.css" />

<section class="food_section layout_padding-bottom">
    <div class="container">
        <div class="heading_container heading_center">
            <h2>Our Menu</h2>
        </div>

        <div id="food-feedback" class="alert d-none" role="alert"></div>

        <ul class="filters_menu">
            <li class="active" data-filter="*">All</li>
            <li data-filter=".burger">Burger</li>
            <li data-filter=".pizza">Pizza</li>
            <li data-filter=".pasta">Pasta</li>
            <li data-filter=".fries">Fries</li>
        </ul>

        <div class="filters-content">
            <div class="row grid">
                <div class="col-sm-6 col-lg-4 all pizza" data-name="Delicious Pizza" data-price="20">
                    <div class="box">
                        <div>
                            <div class="img-box">
                                <img src="/images/f1.png" alt="Delicious Pizza" />
                            </div>
                            <div class="detail-box">
                                <h5 class="name">Delicious Pizza</h5>
                                <p>A crispy crust topped with mozzarella, basil, and tomato sauce.</p>
                                <div class="options">
                                    <h6 class="price">$20.00</h6>
                                    <a href="#" class="cart-icon add-to-cart" data-id="pizza-1" data-name="Delicious Pizza" data-price="20" data-quantity="1" aria-label="Add Delicious Pizza to cart">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-shopping-cart">
                                            <circle cx="9" cy="21" r="1"></circle>
                                            <circle cx="20" cy="21" r="1"></circle>
                                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6 col-lg-4 all burger" data-name="Classic Burger" data-price="15">
                    <div class="box">
                        <div>
                            <div class="img-box">
                                <img src="/images/f2.png" alt="Classic Burger" />
                            </div>
                            <div class="detail-box">
                                <h5 class="name">Classic Burger</h5>
                                <p>Juicy beef patty with cheddar cheese, lettuce, and tomato.</p>
                                <div class="options">
                                    <h6 class="price">$15.00</h6>
                                    <a href="#" class="cart-icon add-to-cart" data-id="burger-1" data-name="Classic Burger" data-price="15" data-quantity="1" aria-label="Add Classic Burger to cart">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-shopping-cart">
                                            <circle cx="9" cy="21" r="1"></circle>
                                            <circle cx="20" cy="21" r="1"></circle>
                                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6 col-lg-4 all pasta" data-name="Creamy Pasta" data-price="18">
                    <div class="box">
                        <div>
                            <div class="img-box">
                                <img src="/images/f3.png" alt="Creamy Pasta" />
                            </div>
                            <div class="detail-box">
                                <h5 class="name">Creamy Pasta</h5>
                                <p>Rich Alfredo sauce tossed with fresh fettuccine and herbs.</p>
                                <div class="options">
                                    <h6 class="price">$18.00</h6>
                                    <a href="#" class="cart-icon add-to-cart" data-id="pasta-1" data-name="Creamy Pasta" data-price="18" data-quantity="1" aria-label="Add Creamy Pasta to cart">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-shopping-cart">
                                            <circle cx="9" cy="21" r="1"></circle>
                                            <circle cx="20" cy="21" r="1"></circle>
                                            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script src="/js/food-section.js"></script>
